				<cfif postScrollWidgetType eq 'popularPosts'>
					<h1 class="topContent" <cfif darkTheme>style="color:ivory"</cfif>>Popular Blogs</h1>
				<cfelseif postScrollWidgetType eq 'Related Pages'>
					<h2 class="topContent">Related Pages</h2>
				<cfelse>
					<h2 class="topContent">Related Blogs</h2>
				</cfif>

				<!--- Card width: renderNarrowPopularPostCard picks between the original fixed-235px narrow-carousel
				look and the real post grid's responsive width (renderKendoCardGrid.cfm / blogContentHtml.cfm) - a
				hardcoded width doesn't scale with the container the way the percentage-based real post cards do, so
				with it off this widget lines up with the "All Blogs" cards below it at any viewport instead of
				visibly shrinking relative to them. The curated homepage (curatedHomepageContentHtml.cfm) sets a
				page-scope renderNarrowPopularPostCard before including this template (narrow when no Featured
				Pages/Collections are showing, aligned when either is) - checked explicitly with isDefined() rather
				than relying on an implicit scope cascade to application.cfc, which isn't guaranteed across engines.
				Every other caller (blogContentHtml.cfm's own hero widget, the single-post Related Blogs carousel)
				has no such override, so falls back to the application.cfc default below. --->
				<cfif not isDefined("renderNarrowPopularPostCard")>
					<cfset renderNarrowPopularPostCard = application.renderNarrowPopularPostCard>
				</cfif>
				<cfif renderNarrowPopularPostCard>
					<cfset popularPostCardWidthStyle = "235px">
				<cfelseif session.isMobile or showSidebar>
					<cfset popularPostCardWidthStyle = "100%">
				<cfelse>
					<cfset popularPostCardWidthStyle = "31%">
				</cfif>

				<!-- Kendo Scrollwrap container -->
				<div class="k-card-deck-scrollwrap">
					<!-- Render the cards -->
				<cfif session.isMobile or arrayLen(getPosts) gt 3>
					<button class="k-button k-button-solid-base k-button-solid k-button-md k-rounded-md k-icon-button k-button-scroll" aria-label="back" style="width: 35px; height:35px; border-radius: 50%; left:22px; top:130px; z-index:2;">
						<span class="k-button-icon k-icon k-i-arrow-chevron-left"></span>
					</button>
				</cfif>
					<div class="k-card-deck">
					<!--- Events (2026-10-16): the events among these cards, looked up once (Events.cfc getCardEvents). An event post's card shows when it is under its title, and a date tile instead of the no-image picture. --->
					<cfset popularCardPostIds = []>
					<cfloop from="1" to="#arrayLen(getPosts)#" index="popularCardIndex"><cfset arrayAppend(popularCardPostIds, getPosts[popularCardIndex]["PostId"])></cfloop>
					<cfset popularCardEvents = structKeyExists(application, "events") ? application.events.getCardEvents(popularCardPostIds) : {}>
					<!--- Loop through the array --->
					<cfloop from="1" to="#arrayLen(getPosts)#" index="i">
						<!--- Note: this is nearly identical to the normal rendering of posts in card format, other than we are always using the thumbnail image. --->
						<cfif i lte arrayLen(getPosts)>
						<cfsilent>	
						<!--- Preset vars --->
						<!--- Don't set the new postId. Use the getPosts[i]["PostId"] var for this so it does not reset the reset the real postId --->
						<cfset promotedPost = ''>  
						<cfset title = ''>
						<cfset author = ''>
						<cfset postUrl = ''>
						<cfset postContent = ''>
						<cfset enclosure = ''>
						<cfset thumbNail = ''>
						<cfset mediaId = ''>
						<cfset mediaType = ''>
						<cfset mediaUrl = ''>
						<cfset providerVideoId = ''>
						<cfset MediaVideoCoverUrl = ''>
						<cfset mediaVideoVttFileUrl = ''>
						<cfset enclosureMapIdList = ''>
						<cfset enclosureMapId = ''>
						<cfset enclosureCarouselId = ''>
						<cfset datePosted = ''>
						<!--- Also reset the thumbnailMedia and carousels generated by the Renderer obj --->
						<cfset thumbnailMedia = ''>
						<cfset thumbnailCarousel = ''>
						<cfset cardEvent = structKeyExists(popularCardEvents, getPosts[i]["PostId"]) ? popularCardEvents[getPosts[i]["PostId"]] : {}>
						<cfset cardEventTile = false>

						<!--- Get the data --->		
						<cfset thisBlogId = 1>
						<!--- Don't set the new postId. Use the getPosts[i]["PostId"] var for this so it does not reset the reset the real postId --->
						<cfset promotedPost = getPosts[i]["Promoted"]>
						<cfset title = getPosts[i]["Title"]>
						<cfset author = getPosts[i]["FullName"]>
						<!---
						Original code
						<cfset postUrl = application.blog.makeLink(getPosts[i]["PostId"])>
						--->
						<cfset postUrl = application.blog.makeLink(
							isPage=getPosts[i]["IsPage"], 
							postAlias=getPosts[i]["PostAlias"], 
							datePosted=getPosts[i]["DatePosted"])>
						<cfset postContent = getPosts[i]["Description"]>
						<cfset enclosure = getPosts[i]["MediaUrl"]>
						<cfset thumbnail = getPosts[i]["MediaThumbnailUrl"]>
						<cfset mediaId = getPosts[i]["MediaId"]>
						<cfset mediaType = getPosts[i]["MediaType"]>
						<cfset mediaUrl = getPosts[i]["MediaUrl"]>
						<cfset providerVideoId = getPosts[i]["ProviderVideoId"]>
						<cfset MediaVideoCoverUrl = getPosts[i]["MediaVideoCoverUrl"]>
						<cfset mediaVideoVttFileUrl = getPosts[i]["mediaVideoVttFileUrl"]>
						<!--- Set the enclosureMapIdList. We only need to get the value of the first item in the list as all of the values are the same --->
						<cfset enclosureMapIdList = getPosts[1]["EnclosureMapIdList"]>
						<!--- Get the map Id of the current row in the list. --->
						<cfset enclosureMapId = getPosts[i]["EnclosureMapId"]>
						<cfset enclosureCarouselId = getPosts[i]["EnclosureCarouselId"]>
						<cfset datePosted = getPosts[i]["DatePosted"]> 
						
						<!--- Get the categories for this post. --->
						<cfset getCategories = application.blog.getCategoriesByPostId(getPosts[i]["PostId"])>
						<!--- Get the top level category in the hiearchy. This will cause an error if the post has no category --->
						<cftry>
							<cfset parentCategory = getCategories[1]["Category"]>
							<cfcatch type="any">
								<cfset parentCategory = "">
							</cfcatch>
						</cftry>

						<!--- ************************* The top of the card ************************* --->
						<!--- The same answer as the other cards (2026-11-06, the hero pipeline): Renderer.cfc renderCardMedia. The order used to
						differ here (the map before a picture or video), and a picture with no thumbnail got the no-picture art. --->
						<cfset cardMedia = RendererObj.renderCardMedia(post = getPosts[i], renderMediumCard = false, showSidebar = showSidebar,
							cardEvent = cardEvent, defaultImage = application.baseUrl & "/images/thumbnails/noImage.jpg")>
						<cfset cardMediaHtml = cardMedia.html>
						<cfset cardImage = cardMedia.imageUrl>
						<cfset suppressCardImage = cardMedia.suppressImage>
						<cfset cardEventTile = cardMedia.eventTile>

						<!--- Remove HTML from the string --->
						<cfinvoke component="#application.jsoupComponentPath#" method="jsoupConvertHtmlToText" returnvariable="postContent">
							<cfinvokeargument name="html" value="#postContent#">
						</cfinvoke>

						<!--- An event with its own picture, gradient, video, map or carousel: the calendar page in the middle of it (owner, 10-16); clicks go through it. --->
						<cfset cardEventOverlay = not structIsEmpty(cardEvent) and not cardEventTile and not suppressCardImage>

						<!--- Make the string a bit longer white white space if it is too short --->
						<cfif len(postContent) lt 100>
							<cfset postContent = postContent & "&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;">
						</cfif>
							
						</cfsilent>
							<!--- Note: this is using the k-card-deck image --->
							<div class="k-card k-card-type-rich<cfif promotedPost>highlightedWidget</cfif>" style="width: <cfoutput>#popularPostCardWidthStyle#</cfoutput>;">
								<a href="<cfoutput>#postUrl#</cfoutput>"><cfif cardEventOverlay><div class="galaxieEventOnPicture"></cfif><cfif len(cardMediaHtml)><cfoutput>#cardMediaHtml#</cfoutput><cfelseif not suppressCardImage><div class="img-hover-zoom img-hover-brightzoom"><img class="fade lazied shown k-card-scroll-image" data-type="image" data-src="<cfoutput>#cardImage#</cfoutput>" alt="<cfoutput>#title#</cfoutput>" data-lazied="IMG" src="<cfoutput>#cardImage#</cfoutput>"></div></cfif><cfif cardEventOverlay><cfoutput>#application.events.renderSheetOverlayHtml(cardEvent)#</cfoutput></div></cfif></a>
								<div class="k-card-body">
									<!-- The font should be 14pt for this compact widget. No extra margins are necessary for the popular posts -->
									<h2 class="k-card-title" style="font-size: 14pt;"><cfif promotedPost>&nbsp;<i class="fa fa-bullhorn" aria-hidden="true" title="Announcement"></i>&nbsp;&nbsp;</cfif><a href="<cfoutput>#postUrl#</cfoutput>" aria-label="<cfoutput>#title#</cfoutput>"><cfoutput>#title#</cfoutput></a></h4>
									<!--- Author and published date (2026-11-01, owner), Renderer.cfc renderCardByline. --->
									<cfoutput>#RendererObj.renderCardByline(getPosts[i])#</cfoutput>
									<cfif not structIsEmpty(cardEvent)><cfoutput>#application.events.renderCardStripHtml(ev=cardEvent, compact=true, hasTile=cardEventTile or cardEventOverlay)#</cfoutput></cfif>
								</div>
							<cfif postScrollWidgetType eq 'popularPosts'><!--- Only show the read more button for popular posts. --->
								<div class="k-card-actions k-card-actions-stretched k-card-actions-vertical">
									<span class="k-card-action">
										<span class="k-button k-primary" onClick="window.open('<cfoutput>#postUrl#</cfoutput>', '_self')">Read More...</span>
									</span>
								</div>
							</cfif>
							</div><!---<div class="k-card k-card-type-rich">--->
						</cfif><!---<cfif i lte arrayLen(getPost)>--->
						</cfloop>
					</div><!---<div class="k-card-deck">--->
				<cfif session.isMobile or arrayLen(getPosts) gt 3>
					<button class="k-button k-button-solid-base k-button-solid k-button-md k-rounded-md k-icon-button k-button-scroll" aria-label="forward" style="width: 35px; height:35px; border-radius: 50%; right:5px; top:130px; z-index:2;">
						<span class="k-icon k-i-arrow-chevron-right"></span>
					</button>
				</cfif>
				</div><!-- Scrollwrap container -->
				
				<script type="<cfoutput>#application.blog.getScriptTypeString()#</cfoutput>">
					function scrollButtonClick(e) {
						var button = $(e.currentTarget);
						var scrollToLeft = button.find(".k-i-arrow-chevron-left").length !== 0;
						// Scope to this widget's own strip. A bare $(".k-card-deck") picks the first deck on the page, which can be another widget's (for example Featured Collections).
						var scrollContainer = button.closest(".k-card-deck-scrollwrap").find(".k-card-deck").eq(0);
						var lastCard = scrollContainer.find(".k-card").last();
						var cardWidth = lastCard.outerWidth(true);

						if (scrollToLeft) {
							scrollContainer.scrollLeft(scrollContainer.scrollLeft() - cardWidth);
						} else {
							scrollContainer.scrollLeft(scrollContainer.scrollLeft() + cardWidth);
						}
					};

					// Only show the arrows when there is something to scroll to: none when every card fits, back
					// only once the strip is scrolled past the start, and forward only until the last card is visible.
					function updateScrollButtons() {
						var wrap = $(".k-card-deck-scrollwrap").eq(0);
						var scrollContainer = wrap.find(".k-card-deck").eq(0);
						var backButton = wrap.find(".k-i-arrow-chevron-left").closest(".k-button-scroll");
						var forwardButton = wrap.find(".k-i-arrow-chevron-right").closest(".k-button-scroll");
						var el = scrollContainer.get(0);
						if (!el) return;
						var overflows = el.scrollWidth > el.clientWidth + 1;
						var atStart = el.scrollLeft <= 1;
						var atEnd = el.scrollLeft + el.clientWidth >= el.scrollWidth - 1;
						backButton.toggle(overflows && !atStart);
						forwardButton.toggle(overflows && !atEnd);
					};

					$(document).ready(function () {
						var cardDeck = $(".k-card-deck-scrollwrap").eq(0);
						cardDeck.on("click", ".k-button-scroll", scrollButtonClick);
						cardDeck.find(".k-card-deck").on("scroll", updateScrollButtons);
						$(window).on("resize load", updateScrollButtons);
						updateScrollButtons();
					});
				</script>

				<style>
					#hero {
						<!--- display: flex; --->
						justify-content: center;
					}

					.k-card-action > .k-button {
						width: 100%;
					}
					
					.k-card-deck-scrollwrap {
						<!--- max-width: 728px; --->
					}
					
					.k-card-deck-scrollwrap { 
						padding-right: 2px !important;/* Normally 16, but this screws things up */
						width: 95% !important; /* Without this, the scroll widget is to the very right of the container without any padding whatsoever */
					}
				</style>